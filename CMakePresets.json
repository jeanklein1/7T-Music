{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DAWN_DIR": "C:/dev/dawn",
        "DAWN_BUILD": "C:/dev/dawn/out"
      }
    },
    {
      "name": "the-board-full",
      "displayName": "the_board — full",
      "inherits": "base",
      "cacheVariables": {
        "INCUBATOR_DUAL_RENDER_CARTRIDGE": "the_board",
        "THE_BOARD_DEMO": "full"
      }
    },
    {
      "name": "the-board-full-release",
      "displayName": "the_board — full (Release)",
      "inherits": "the-board-full",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "the-board-minimal",
      "displayName": "the_board — minimal",
      "inherits": "base",
      "cacheVariables": {
        "INCUBATOR_DUAL_RENDER_CARTRIDGE": "the_board",
        "THE_BOARD_DEMO": "minimal"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "the-board-full",
      "configurePreset": "the-board-full",
      "targets": [ "incubator_dual" ]
    },
    {
      "name": "the-board-full-release",
      "configurePreset": "the-board-full-release",
      "targets": [ "incubator_dual" ]
    },
    {
      "name": "the-board-minimal",
      "configurePreset": "the-board-minimal",
      "targets": [ "incubator_dual" ]
    }
  ]
}