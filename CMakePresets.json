{
  "version": 3,
  "configurePresets": [
    {
      "name": "native",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "T7_RENDER_CARTRIDGE": "the_board",
        "THE_BOARD_DEMO": "full",
        "DAWN_DIR": "C:/dev/dawn",
        "DAWN_BUILD": "C:/dev/dawn/out"
      }
    },
    {
      "name": "the-board-full-release",
      "displayName": "the_board — the program (Ninja, Release)",
      "inherits": "native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "the-board-full-release-meter",
      "displayName": "the_board — the program, frame meter armed (Ninja, Release)",
      "inherits": "the-board-full-release",
      "cacheVariables": {
        "T7_INSTRUMENTS": "meter"
      }
    },
    {
      "name": "the-board-minimal",
      "displayName": "the_board — minimal demo column (Ninja, Release)",
      "inherits": "the-board-full-release",
      "cacheVariables": {
        "THE_BOARD_DEMO": "minimal"
      }
    },
    {
      "name": "the-board-vs",
      "displayName": "the_board — the program (Visual Studio, multi-config)",
      "inherits": "native",
      "generator": "Visual Studio 18 2026"
    }
  ],
  "buildPresets": [
    {
      "name": "the-board-full-release",
      "configurePreset": "the-board-full-release",
      "targets": ["the_board"]
    },
    {
      "name": "the-board-full-release-meter",
      "configurePreset": "the-board-full-release-meter",
      "targets": ["the_board"]
    },
    {
      "name": "the-board-minimal",
      "configurePreset": "the-board-minimal",
      "targets": ["the_board"]
    },
    {
      "name": "the-board-vs-release",
      "configurePreset": "the-board-vs",
      "configuration": "Release",
      "targets": ["the_board"]
    },
    {
      "name": "the-board-vs-debug",
      "configurePreset": "the-board-vs",
      "configuration": "Debug",
      "targets": ["the_board"]
    }
  ]
}
